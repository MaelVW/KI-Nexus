<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: Testprojekte sind eigene, startbare Programme. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KiNexus.Engines\KiNexus.Engines.csproj" />
  </ItemGroup>

  <!-- Gemeinsame Test-Helfer aus dem Core-Testprojekt mitbenutzen. -->
  <ItemGroup>
    <Compile Include="..\KiNexus.Core.Tests\TempDirectory.cs" Link="Helpers\TempDirectory.cs" />
    <Compile Include="..\KiNexus.Core.Tests\GgufTestFile.cs" Link="Helpers\GgufTestFile.cs" />
  </ItemGroup>

</Project>
