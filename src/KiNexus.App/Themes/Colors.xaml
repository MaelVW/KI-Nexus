<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Alle Farben von KI-Nexus an einem Ort (Bauplan, Kapitel 7).
        Die Akzent-Farben setzt der ThemeService beim Start neu (Einstellung "Akzentfarbe").
        Darum immer mit DynamicResource auf Akzent-Pinsel verweisen.
    -->

    <Color x:Key="Color.Background">#0A0E13</Color>
    <Color x:Key="Color.Surface">#111820</Color>
    <Color x:Key="Color.SurfaceLight">#18212B</Color>
    <Color x:Key="Color.Border">#22303C</Color>
    <Color x:Key="Color.Accent">#00E5FF</Color>
    <Color x:Key="Color.AccentDim">#0FA3B8</Color>
    <Color x:Key="Color.Text">#E6F1F5</Color>
    <Color x:Key="Color.TextMuted">#8A9BA8</Color>
    <Color x:Key="Color.Success">#3DDC97</Color>
    <Color x:Key="Color.Warning">#FFC857</Color>
    <Color x:Key="Color.Error">#FF5C7A</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceLight" Color="{StaticResource Color.SurfaceLight}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentDim" Color="{StaticResource Color.AccentDim}" />
    <!-- Akzent mit wenig Deckkraft, z.B. für gewählte Elemente. -->
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.Accent}" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />

    <!-- Text auf Akzent-Flächen (z.B. Hauptknopf). -->
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.Background}" />
    <!-- Schliessen-Knopf der Titelleiste beim Darüberfahren (wie in Windows 11). -->
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C" />
    <!-- Abdunkeln hinter Dialogen. -->
    <SolidColorBrush x:Key="Brush.Overlay" Color="#000000" Opacity="0.55" />

</ResourceDictionary>
