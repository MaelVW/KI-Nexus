<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Schriften: Segoe UI Variable für die Oberfläche, Cascadia Mono für Terminal und Code. -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.UiDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <!-- Symbole: die Zeichen-Codes stehen in Glyphs.cs. -->
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Normal">14</sys:Double>
    <sys:Double x:Key="FontSize.Large">18</sys:Double>
    <sys:Double x:Key="FontSize.Title">26</sys:Double>

    <!-- Ecken (Kapitel 7: 8 px Radius). -->
    <CornerRadius x:Key="Radius.Normal">8</CornerRadius>
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>

</ResourceDictionary>
