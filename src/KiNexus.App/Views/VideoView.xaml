<UserControl x:Class="KiNexus.App.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:conv="clr-namespace:KiNexus.App.Converters"
             xmlns:video="clr-namespace:KiNexus.Core.Video;assembly=KiNexus.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VideoViewModel}">

    <!-- Studio (Bauplan Video, Kapitel 7, und Bauplan Bild, B2): oben Video | Bild, links der Auftrag und der Fortschritt,
         rechts Player (oder Bild) und Galerie, unten eine Meldung. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:PathToThumbnailConverter x:Key="Thumbnail" />
        <conv:FitLevelToBrushConverter x:Key="FitBrush" />
        <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== Links: Auftrag und Fortschritt ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="studioMode" AutomationProperties.AutomationId="StudioVideo"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StudioMode.Video}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Video}" />
                                        <TextBlock Text="Video" Margin="8,0,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="studioMode" AutomationProperties.AutomationId="StudioImage"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StudioMode.Image}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Image}" />
                                        <TextBlock Text="Bild" Margin="8,0,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Studio" FontFamily="{StaticResource Font.UiDisplay}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Ehrliche Grenzen (Bauplan Video, Kapitel 3, und docs/11-Bild.md) -->
                    <Border Margin="0,10,0,16" Padding="14,10" CornerRadius="{StaticResource Radius.Normal}" BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.AccentDim}" Background="{DynamicResource Brush.AccentSoft}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="{x:Static app:Glyphs.Info}" VerticalAlignment="Top" Margin="0,2,10,0"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" MaxWidth="370" LineHeight="20" AutomationProperties.AutomationId="VideoLimits"
                                           Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}"
                                           Text="Videos mit Ton aus einer Beschreibung, mit LTX-2.3 über ComfyUI. Ehrliche Grenzen: kurze Clips (bis ca. 10 s), ein 4-Sekunden-Clip dauert ca. 2–3 Minuten. Während ein Video entsteht, geht der Chat nicht: Der Grafikspeicher reicht nicht für beides." />
                                <TextBlock TextWrapping="Wrap" MaxWidth="370" LineHeight="20" AutomationProperties.AutomationId="ImageLimits"
                                           Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibility}}"
                                           Text="{Binding ImageLimits}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Einrichtung -->
                    <Border Style="{StaticResource StepCard}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                            Visibility="{Binding HasSetupProblem, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Noch nicht eingerichtet" Style="{StaticResource StepTitle}" />
                            <TextBlock Text="{Binding SetupProblem}" TextWrapping="Wrap" AutomationProperties.AutomationId="VideoSetup" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Einrichten (Skript starten)" Command="{Binding RunSetupCommand}" Margin="0,0,8,0"
                                        ToolTip="Startet scripts\setup-video.ps1 in einem eigenen Fenster. Es lädt fehlende Dateien mit Prüfsumme." />
                                <Button Content="Nochmals prüfen" Command="{Binding CheckSetupCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Auftrag -->
                    <Border Style="{StaticResource StepCard}">
                        <!-- Bleibt bedienbar, während ein Video entsteht: So kann man den nächsten Auftrag für die Warteschlange vorbereiten. -->
                        <StackPanel>
                            <TextBlock Text="Auftrag" Style="{StaticResource StepTitle}" />
                            <StackPanel Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Bildmodell" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ImageModels}" SelectedItem="{Binding SelectedImageModel}" DisplayMemberPath="Name" Margin="0,0,0,12"
                                          AutomationProperties.Name="Bildmodell" AutomationProperties.AutomationId="ImageModel" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Videomodell" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding VideoModels}" SelectedItem="{Binding SelectedModel}" AutomationProperties.Name="Videomodell"
                                      AutomationProperties.AutomationId="VideoModel" />
                            <TextBlock Text="{Binding ModelNote}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,10"
                                       AutomationProperties.AutomationId="VideoModelNote" />
                            <TextBlock Text="Ablauf" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Margin="0,0,0,12" AutomationProperties.Name="Ablauf"
                                      AutomationProperties.AutomationId="VideoProcess"
                                      ToolTip="Muss zum Modell passen. Ein dev-Modell mit „Schnell“ gibt ein verrauschtes Video." />
                            </StackPanel>
                            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                     MaxHeight="220" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" SpellCheck.IsEnabled="False"
                                     AutomationProperties.Name="{Binding PromptName}" AutomationProperties.AutomationId="VideoPrompt" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,6,0,12" TextWrapping="Wrap" Text="{Binding PromptHint}" />
                            <WrapPanel Margin="0,-6,0,12">
                                <Button Content="Prompt verbessern (KI)" Command="{Binding ImprovePromptCommand}" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="VideoImprovePrompt"
                                        ToolTip="Die KI aus der Kopfleiste macht aus deiner Idee (auch auf Deutsch) einen ausführlichen englischen Prompt." />
                                <Button Style="{StaticResource Button.Ghost}" Content="Rückgängig" Command="{Binding UndoPromptCommand}"
                                        AutomationProperties.AutomationId="VideoUndoPrompt" />
                            </WrapPanel>

                            <!-- Bild: Format und Anzahl -->
                            <WrapPanel Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Format" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <ComboBox Width="250" ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding SelectedImageFormat}" AutomationProperties.Name="Bildformat"
                                              AutomationProperties.AutomationId="ImageFormat" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Anzahl Bilder" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <ComboBox Width="80" ItemsSource="{Binding ImageCounts}" SelectedItem="{Binding ImageCount}" AutomationProperties.Name="Anzahl Bilder"
                                              AutomationProperties.AutomationId="ImageCount"
                                              ToolTip="Alle Bilder entstehen in einem Durchgang, mit demselben Prompt und Seed, aber verschieden." />
                                </StackPanel>
                            </WrapPanel>

                            <!-- Bild: Referenzbilder -->
                            <StackPanel Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                                <TextBlock Text="Referenzbilder (optional)" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding ReferenceImages}" AutomationProperties.Name="Referenzbilder"
                                              AutomationProperties.AutomationId="ImageReferences">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="96" Height="72" Margin="0,0,8,8" ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
                                                <Border Background="Black" CornerRadius="{StaticResource Radius.Small}" ClipToBounds="True">
                                                    <Image Source="{Binding Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                                                </Border>
                                                <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                        Background="#B0000000" AutomationProperties.Name="Referenz entfernen" ToolTip="Entfernen"
                                                        Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="10" Foreground="White" Text="{x:Static app:Glyphs.Close}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Content="Bild hinzufügen …" Command="{Binding AddReferenceCommand}" Margin="0,0,8,0"
                                            AutomationProperties.AutomationId="ImageAddReference" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Alle entfernen" Command="{Binding ClearReferencesCommand}"
                                            Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ReferenceHint}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="ImageReferenceHint" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Startbild (optional, Bild zu Video)" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="64" Background="Black" CornerRadius="{StaticResource Radius.Small}" ClipToBounds="True" Margin="0,0,10,0"
                                        Visibility="{Binding HasStartImage, Converter={StaticResource BoolToVisibility}}">
                                    <Image Source="{Binding StartImagePath, Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel>
                                        <Button Content="Bild wählen …" Command="{Binding PickStartImageCommand}" Margin="0,0,8,0"
                                                AutomationProperties.AutomationId="VideoPickImage" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Entfernen" Command="{Binding ClearStartImageCommand}"
                                                Visibility="{Binding HasStartImage, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding StartImagePath}" Style="{StaticResource Text.Hint}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="VideoStartImage" />
                                    <TextBlock Text="{Binding StartImageHint}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsDevProcess, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                                <TextBlock Text="Negativ-Prompt (was nicht vorkommen soll)" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="40"
                                         AutomationProperties.Name="Negativ-Prompt" AutomationProperties.AutomationId="VideoNegativePrompt" />
                                <TextBlock Text="{Binding NegativePromptHint}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <WrapPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Format" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <ComboBox Width="250" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" AutomationProperties.Name="Format"
                                              AutomationProperties.AutomationId="VideoFormat" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Länge" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <ComboBox Width="140" ItemsSource="{Binding Lengths}" SelectedItem="{Binding SelectedLength}" AutomationProperties.Name="Länge"
                                              AutomationProperties.AutomationId="VideoLength" />
                                </StackPanel>
                            </WrapPanel>

                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Mit Ton" IsChecked="{Binding WithAudio}" Margin="0,0,0,12"
                                      AutomationProperties.AutomationId="VideoAudio"
                                      ToolTip="Das Modell erzeugt Bild und Ton zusammen. Ohne Ton hat das Video keine Tonspur." />
                            </StackPanel>

                            <TextBlock Text="Seed" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Width="150" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Seed" AutomationProperties.AutomationId="VideoSeed"
                                         ToolTip="Startzahl fürs Rauschen. Gleicher Seed und gleicher Prompt ergeben dasselbe Ergebnis." />
                                <Button Content="Zufall" Command="{Binding RandomSeedCommand}" Margin="8,0,0,0" ToolTip="Neuen Seed würfeln" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Seed behalten" IsChecked="{Binding KeepSeed}" Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="VideoKeepSeed"
                                          ToolTip="Aus: Jeder Auftrag bekommt einen neuen Seed. Ein: Der Seed im Feld bleibt." />
                            </StackPanel>

                            <!-- Speicher-Ampel (nur Video) -->
                            <StackPanel Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" DataContext="{Binding Fit}">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Level, Converter={StaticResource FitBrush}}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Label, StringFormat='Speicher: {0}'}" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="VideoFit" />
                            </StackPanel>
                            <TextBlock Text="{Binding Fit.Explanation}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       AutomationProperties.AutomationId="VideoFitText" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,-6,0,16">
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding GenerateText}" Command="{Binding GenerateCommand}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="VideoGenerate" />
                        <Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="VideoCancel" />
                        <Button Content="In die Warteschlange" Command="{Binding EnqueueCommand}" AutomationProperties.AutomationId="VideoEnqueue"
                                ToolTip="Läuft schon ein Auftrag, kommt dieser danach dran. So kannst du mehrere Videos und Bilder nacheinander erzeugen, z.B. über Nacht." />
                    </WrapPanel>

                    <!-- Warteschlange -->
                    <Border Style="{StaticResource StepCard}" Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Leeren" Command="{Binding ClearQueueCommand}" />
                                <TextBlock Text="{Binding QueueText}" Style="{StaticResource StepTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Queue}" AutomationProperties.Name="Warteschlange" AutomationProperties.AutomationId="VideoQueue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StudioJob}">
                                        <DockPanel Margin="0,0,0,6" AutomationProperties.Name="{Binding Label}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" AutomationProperties.Name="Aus der Warteschlange nehmen"
                                                    Command="{Binding DataContext.RemoveQueuedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Aus der Warteschlange nehmen">
                                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Close}" />
                                            </Button>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Small}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Fortschritt -->
                    <Border Style="{StaticResource StepCard}">
                        <StackPanel>
                            <TextBlock Text="Fortschritt" Style="{StaticResource StepTitle}" />
                            <TextBlock Text="{Binding StageText}" TextWrapping="Wrap" AutomationProperties.AutomationId="VideoStage" AutomationProperties.LiveSetting="Polite" />
                            <ProgressBar Height="8" Margin="0,8,0,4" Maximum="100" Value="{Binding ProgressValue}" AutomationProperties.Name="Fortschritt des Auftrags" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Hint}" AutomationProperties.AutomationId="VideoProgress" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding BackendStatus}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="VideoBackendStatus" />
                        <Button Style="{StaticResource Button.Ghost}" Content="ComfyUI beenden" Command="{Binding StopBackendCommand}" Margin="8,0,0,0"
                                ToolTip="Gibt RAM und VRAM frei. ComfyUI startet beim nächsten Auftrag wieder von selbst." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Rechts: Player und Galerie ===================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <Border Height="330" Background="Black" CornerRadius="{StaticResource Radius.Small}" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"
                                              AutomationProperties.Name="Video-Player" AutomationProperties.AutomationId="VideoPlayer" />
                                <Image Source="{Binding SelectedVideo.VideoPath, Converter={StaticResource Thumbnail}, ConverterParameter=1400}" Stretch="Uniform"
                                       Visibility="{Binding HasSelectedImage, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.Name="Gewähltes Bild" AutomationProperties.AutomationId="StudioImageView" />
                                <TextBlock Text="Noch nichts erzeugt. Schreib links einen Auftrag und klick auf „Video erzeugen“ oder „Bilder erzeugen“." Foreground="{StaticResource Brush.TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"
                                           Visibility="{Binding HasNoVideos, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock x:Name="PlayerError" Foreground="{StaticResource Brush.Error}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Visibility="Collapsed" AutomationProperties.AutomationId="VideoPlayerError" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPause" Style="{StaticResource Button.Icon}" Click="PlayPause_Click" VerticalAlignment="Top" Margin="0,0,10,0"
                                    Visibility="{Binding HasSelectedVideo, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Abspielen" AutomationProperties.AutomationId="VideoPlayPause" ToolTip="Abspielen / Pause">
                                <TextBlock x:Name="PlayPauseIcon" Style="{StaticResource Text.Icon}" FontSize="16" Text="{x:Static app:Glyphs.Play}" />
                            </Button>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedVideo.Prompt}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="VideoSelectedPrompt" />
                                <TextBlock Text="{Binding SelectedInfo}" Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="VideoInfo" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource Button.Primary}" Content="Als Startbild für ein Video" Command="{Binding UseAsStartImageCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding HasSelectedImage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="StudioUseAsStart"
                                    ToolTip="Wechselt auf Video. Das Bild wird das erste Bild des Videos." />
                            <Button Content="Als Referenz für ein Bild" Command="{Binding UseAsReferenceCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding HasSelectedImage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="StudioUseAsReference"
                                    ToolTip="Wechselt auf Bild. Das neue Bild orientiert sich an diesem (z.B. dieselbe Person oder derselbe Ort)." />
                            <Button Content="Prompt übernehmen" Command="{Binding ReusePromptCommand}" Margin="0,0,8,8"
                                    ToolTip="Prompt, Format, Seed und die übrigen Einstellungen ins Formular links übernehmen" />
                            <Button Content="Nochmal (gleicher Seed)" Command="{Binding RepeatSameSeedCommand}" Margin="0,0,8,8"
                                    ToolTip="Genau dasselbe nochmals erzeugen" />
                            <Button Content="Nochmal (neuer Seed)" Command="{Binding RepeatNewSeedCommand}" Margin="0,0,8,8"
                                    ToolTip="Derselbe Prompt, aber ein anderes Ergebnis" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Button.Ghost}" Content="In den Papierkorb" Command="{Binding DeleteVideoCommand}" Margin="0,0,8,8"
                                    AutomationProperties.AutomationId="VideoDelete" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <DockPanel Grid.Row="1">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="galleryFilter" Content="Alle" AutomationProperties.AutomationId="GalleryAll"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:GalleryFilter.All}}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="galleryFilter" Content="Videos" AutomationProperties.AutomationId="GalleryVideos"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:GalleryFilter.Videos}}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="galleryFilter" Content="Bilder" AutomationProperties.AutomationId="GalleryImages"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:GalleryFilter.Images}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Galerie" Style="{StaticResource StepTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}" Style="{StaticResource ListBox.Plain}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Galerie"
                             AutomationProperties.AutomationId="VideoGallery">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Card}">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Prompt}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type video:VideoEntry}">
                                <StackPanel Width="160" ToolTip="{Binding Prompt}">
                                    <Border Height="100" Background="Black" CornerRadius="{StaticResource Radius.Small}" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                                            <!-- Kennzeichen unten links: Video oder Bild -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="4,2" CornerRadius="3" Background="#B0000000">
                                                <TextBlock FontSize="11" Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                                            <Setter Property="Text" Value="{x:Static app:Glyphs.Video}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                    <Setter Property="Text" Value="{x:Static app:Glyphs.Image}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSize.Small}" TextTrimming="CharacterEllipsis" Text="{Binding Prompt}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}"
                                               Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM. HH:mm}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Meldung -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Background="{StaticResource Brush.Surface}"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="VideoStatus" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Icon}" Command="{Binding DismissStatusCommand}"
                        AutomationProperties.Name="Meldung schliessen" ToolTip="Schliessen">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Close}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
