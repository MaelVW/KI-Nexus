<UserControl x:Class="KiNexus.App.Views.NewKiWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:kis="clr-namespace:KiNexus.Core.Kis;assembly=KiNexus.Core"
             xmlns:conv="clr-namespace:KiNexus.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewKiWizardViewModel}">

    <!-- Assistent "Neue KI": 4 Schritte, unten Zurück / Weiter / Speichern. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,16,24,20" MaxWidth="900" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf: Schritt x von 4 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" />
            <TextBlock Text="{Binding StepTitle}" FontFamily="{StaticResource Font.UiDisplay}" FontSize="{StaticResource FontSize.Title}"
                       FontWeight="SemiBold" AutomationProperties.AutomationId="WizardStepTitle" AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>

        <!-- Inhalt der Schritte -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <!-- Schritt 1: Grundmodell -->
                <DockPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Hint}" Margin="0,0,0,10"
                               Text="Wähle das Modell, auf dem deine KI aufbaut. Modelle aus models/ laufen mit llama.cpp, Modelle aus Ollama mit Ollama." />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Hint}" Margin="0,0,0,10" Text="{Binding OllamaHint}"
                               Visibility="{Binding OllamaHint, Converter={StaticResource NullToVisibility}}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding Fit, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="Passt es auf deinen Laptop?" Style="{StaticResource Text.Label}" Margin="0,0,12,0" />
                        <ContentControl Content="{Binding Fit}" Focusable="False" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Style="{StaticResource ListBox.Plain}"
                             ItemContainerStyle="{StaticResource ListBoxItem.Card}" AutomationProperties.Name="Grundmodelle"
                             AutomationProperties.AutomationId="WizardModels">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModelChoice}">
                                <Grid AutomationProperties.Name="{Binding Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding EngineText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Schritt 2: Name und Beschreibung -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Name" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                             AutomationProperties.Name="Name der KI" AutomationProperties.AutomationId="WizardName" />
                    <TextBlock Text="{Binding IdPreview}" Style="{StaticResource Text.Hint}" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Text="Kurze Beschreibung (optional)" Style="{StaticResource Text.Label}" Margin="0,18,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                             AutomationProperties.Name="Beschreibung der KI" AutomationProperties.AutomationId="WizardDescription" />
                    <TextBlock Text="z.B. &quot;Hilft mir bei Informatik-Aufträgen&quot;." Style="{StaticResource Text.Hint}" />
                </StackPanel>

                <!-- Schritt 3: Systemprompt -->
                <DockPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Hint}" Margin="0,0,0,10"
                               Text="Der Systemprompt sagt der KI, wer sie ist und wie sie antworten soll. Nimm eine Vorlage und pass sie an." />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PromptTemplates}" Focusable="False" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type kis:PromptTemplate}">
                                <Button Content="{Binding Name}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Vorlage {0}'}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" MinHeight="220" FontFamily="{StaticResource Font.Mono}"
                             AutomationProperties.Name="Systemprompt" AutomationProperties.AutomationId="WizardPrompt" />
                </DockPanel>

                <!-- Schritt 4: Parameter -->
                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Vorlage" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Style="{StaticResource ListBox.Plain}"
                             ItemContainerStyle="{StaticResource ListBoxItem.Card}" AutomationProperties.Name="Parameter-Vorlage"
                             AutomationProperties.AutomationId="WizardPresets">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type kis:ParameterPreset}">
                                <StackPanel AutomationProperties.Name="{Binding Name}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding PresetValuesText}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Kontextlänge" Style="{StaticResource Text.Label}" ToolTip="Wie viel vom Gespräch sich die KI merkt (in Token, ca. 3/4 Wort)." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding ContextLengths}" SelectedItem="{Binding ContextLength}" Width="140"
                                      AutomationProperties.Name="Kontextlänge" />
                            <ContentControl Content="{Binding Fit}" Focusable="False" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding Fit, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Hint}"
                                   Text="Mehr Kontext = längeres Gedächtnis, braucht aber mehr Speicher. 8192 ist ein guter Standard." />
                        <TextBlock Grid.Row="2" Text="Denken" Style="{StaticResource Text.Label}" Margin="0,14,0,0" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ThinkByDefault}"
                                  Content="Standardmässig nachdenken lassen (nur bei Modellen, die das können)" AutomationProperties.Name="Standardmässig nachdenken" />
                    </Grid>
                </StackPanel>

                <!-- Gespeichert: Test-Chat anbieten -->
                <Border Background="{StaticResource Brush.Surface}" Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                        <Grid Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Brush.AccentSoft}" />
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="26" Text="{x:Static app:Glyphs.Add}" Foreground="{DynamicResource Brush.Accent}" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.UiDisplay}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold"
                                   Text="{Binding SavedKi.DisplayName, StringFormat='{}{0} ist bereit'}" AutomationProperties.AutomationId="WizardSaved" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="{Binding SavedKi.Id, StringFormat='Gespeichert als kis/{0}.json. Probier sie gleich in einem Test-Chat aus.'}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Noch eine KI erstellen" Command="{Binding StartOverCommand}" Margin="0,0,8,0" />
                            <Button Content="Test-Chat starten" Style="{StaticResource Button.Primary}" Command="{Binding StartTestChatCommand}"
                                    AutomationProperties.AutomationId="WizardTestChat" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Fuss: Fehler und Knöpfe -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Zurück" Command="{Binding BackCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="WizardBack" />
                <Button Content="Weiter" Style="{StaticResource Button.Primary}" Command="{Binding NextCommand}" AutomationProperties.AutomationId="WizardNext"
                        Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="KI speichern" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="WizardSave"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
