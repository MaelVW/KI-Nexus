<UserControl x:Class="KiNexus.App.Views.OpenWebUiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:owui="clr-namespace:KiNexus.Engines.OpenWebUi;assembly=KiNexus.Engines"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpenWebUiViewModel}"
             Width="420">

    <!-- Panel unter dem Knopf "Alternate Launch": Status, Starten / Stoppen / Im Browser öffnen, Hinweise, Log. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Normal}" Padding="18,16" Margin="8">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="18" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel TextElement.Foreground="{StaticResource Brush.Text}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AddressText}" Style="{StaticResource Text.Hint}" Margin="8,2,0,0"
                           FontFamily="{StaticResource Font.Mono}" />
                <TextBlock Text="Open WebUI" FontFamily="{StaticResource Font.UiDisplay}" FontSize="{StaticResource FontSize.Large}" FontWeight="SemiBold" />
            </DockPanel>

            <!-- Status -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Running}">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Starting}">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Stopping}">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Failed}">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="360"
                           AutomationProperties.AutomationId="OpenWebUiStatus" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- Knöpfe -->
            <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" Margin="0,0,8,8"
                        AutomationProperties.AutomationId="OpenWebUiStart">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Launch}" />
                        <TextBlock Text="Starten" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenBrowserCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="OpenWebUiBrowser">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Globe}" />
                        <TextBlock Text="Im Browser öffnen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="OpenWebUiStop">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Stop}" />
                        <TextBlock Text="Stoppen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Hinweis aus der Prüfung vor dem Start -->
            <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Small}" Background="{StaticResource Brush.SurfaceLight}"
                    Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" LineHeight="20" AutomationProperties.AutomationId="OpenWebUiHint" />
                    <Button HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding CopyLlamaServerUrlCommand}"
                            ToolTip="Kopiert die Adresse von llama-server für die Verbindung in Open WebUI.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Copy}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding LlamaServerUrl, StringFormat='{}{0} kopieren'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Log -->
            <ToggleButton Style="{StaticResource ToggleButton.Header}" Margin="0,12,0,0" IsChecked="{Binding IsLogVisible}"
                          Content="Log anzeigen" AutomationProperties.Name="Log von Open WebUI anzeigen" />
            <TextBox Margin="0,8,0,0" Height="220" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="{StaticResource Font.Mono}"
                     FontSize="{StaticResource FontSize.Small}" VerticalContentAlignment="Top" Text="{Binding LogText, Mode=OneWay}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="OnLogChanged"
                     AutomationProperties.AutomationId="OpenWebUiLog" AutomationProperties.Name="Log von Open WebUI"
                     Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,8,0,0"
                       Text="Startet Open WebUI über uvx im Hintergrund (nur auf diesem Laptop erreichbar). Einstellungen: Zahnrad → Open WebUI." />
        </StackPanel>
    </Border>
</UserControl>
