<Window x:Class="KiNexus.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:KiNexus.App"
        xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
        xmlns:conv="clr-namespace:KiNexus.App.Converters"
        xmlns:settings="clr-namespace:KiNexus.Core.Settings;assembly=KiNexus.Core"
        xmlns:owui="clr-namespace:KiNexus.Engines.OpenWebUi;assembly=KiNexus.Engines"
        xmlns:views="clr-namespace:KiNexus.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="KI-Nexus"
        Icon="/Assets/KiNexus.ico"
        Style="{StaticResource Window.Nexus}"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700">

    <!-- Eigene, dunkle Titelleiste: Windows zeichnet keinen Rahmen, wir zeichnen alles selbst. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <!-- Schild mit dem Namen der Engine (llama.cpp / Ollama). -->
        <Style x:Key="EngineBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Zahl in der Ressourcen-Anzeige. Wird gelb ab 90 % Belegung (über Tag = true). -->
        <Style x:Key="ResourceValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResourceLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <!-- Tastenkürzel: Strg + 1 bis 5 wechselt den Tab, Strg + , öffnet die Einstellungen. -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectTabCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectTabCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectTabCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectTabCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectTabCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding SelectTabCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding Chat.ChatList.NewChatCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Kopfleiste (gleichzeitig Titelleiste) ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo und Name. Hier kann man das Fenster ziehen. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,20,0" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Data="M12,3.5 L19.4,7.75 L19.4,16.25 L12,20.5 L4.6,16.25 L4.6,7.75 Z" />
                        <Path Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.1" Opacity="0.8"
                              Data="M12,12 L12,3.5 M12,12 L19.4,16.25 M12,12 L4.6,16.25" />
                        <Ellipse Canvas.Left="10.4" Canvas.Top="10.4" Width="3.2" Height="3.2" Fill="{DynamicResource Brush.Accent}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="KI-Nexus" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.UiDisplay}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>

            <!-- KI-Auswahl mit Schild für die Engine und Status-Punkt. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox Width="230" ItemsSource="{Binding Kis}" SelectedItem="{Binding SelectedKi}"
                          AutomationProperties.Name="KI-Auswahl" ToolTip="Welche KI antwortet">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource EngineBadge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding EngineLabel}" FontSize="11" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Status: grau = nichts geladen, gelb = lädt, grün = bereit, Akzent = antwortet. -->
                <Grid Width="28" Height="28" Margin="4,0,0,0" Background="Transparent"
                      ToolTip="{Binding EngineStatus}" AutomationProperties.Name="Engine-Status" AutomationProperties.HelpText="{Binding EngineStatus}">
                    <Ellipse Width="10" Height="10">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineState}" Value="Loading">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineState}" Value="Ready">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineState}" Value="Answering">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Effect" Value="{DynamicResource Effect.Glow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </StackPanel>

            <!-- Stil-Umschalter, nur im Chat-Tab sichtbar. -->
            <Border Grid.Column="2" Style="{StaticResource SegmentHost}" Margin="8,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsChatTabSelected, Converter={StaticResource BoolToVisibility}}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Terminal" AutomationProperties.AutomationId="Style_Terminal"
                                 IsChecked="{Binding Chat.Style, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static settings:ChatStyle.Terminal}}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Simpel" AutomationProperties.AutomationId="Style_Simple"
                                 IsChecked="{Binding Chat.Style, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static settings:ChatStyle.Simple}}" />
                </StackPanel>
            </Border>

            <!-- Ressourcen-Anzeige: VRAM und RAM übereinander, alle 2 Sekunden gemessen. -->
            <Border Grid.Column="4" Margin="0,0,8,0" Padding="10,3" VerticalAlignment="Center" CornerRadius="{StaticResource Radius.Small}"
                    Background="{StaticResource Brush.Surface}" WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Grafikspeicher (VRAM) und Arbeitsspeicher (RAM): belegt / gesamt. Gelb ab 90 %.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="VRAM" Style="{StaticResource ResourceLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding VramText}" Tag="{Binding IsVramHigh}" Style="{StaticResource ResourceValue}"
                               AutomationProperties.AutomationId="VramText" />
                    <TextBlock Grid.Row="1" Text="RAM" Style="{StaticResource ResourceLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RamText}" Tag="{Binding IsRamHigh}" Style="{StaticResource ResourceValue}"
                               AutomationProperties.AutomationId="RamText" />
                </Grid>
            </Border>

            <!-- Knöpfe: Alternate Launch (Open WebUI), Entladen, Einstellungen. Der Schalter "Lokal | Server" kommt in M9. -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid DataContext="{Binding OpenWebUi}" Margin="0,0,2,0">
                    <ToggleButton x:Name="OpenWebUiButton" Width="40" Height="36" Padding="0" Style="{StaticResource ToggleButton.HeaderIcon}"
                                  IsChecked="{Binding IsPanelOpen}" AutomationProperties.Name="Alternate Launch: Open WebUI"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=OpenWebUiPopup, Converter={StaticResource InverseBool}}"
                                  AutomationProperties.AutomationId="OpenWebUiButton" ToolTip="{Binding ToolTipText}">
                        <Grid>
                            <TextBlock Style="{StaticResource Text.Icon}" Text="{x:Static app:Glyphs.Globe}" />
                            <!-- Statuspunkt: grün = läuft, gelb = startet, rot = Fehler -->
                            <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-3">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Running}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Starting}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static owui:OpenWebUiState.Failed}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Fill" Value="{StaticResource Brush.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </ToggleButton>
                    <!-- Klick daneben schliesst das Panel. Während es offen ist, nimmt der Knopf keine Klicks an (sonst ginge es gleich wieder auf). -->
                    <Popup x:Name="OpenWebUiPopup" IsOpen="{Binding IsPanelOpen}" PlacementTarget="{Binding ElementName=OpenWebUiButton}" Placement="Bottom"
                           HorizontalOffset="-380" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <views:OpenWebUiPanel />
                    </Popup>
                </Grid>
                <Button Width="40" Height="36" Padding="0" Command="{Binding UnloadCommand}" AutomationProperties.Name="Modell entladen"
                        ToolTip="Modell entladen: gibt VRAM und RAM sofort frei, z.B. vor dem Gamen">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{x:Static app:Glyphs.Power}" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Width="40" Height="36" Padding="0" Margin="2,0,0,0"
                        Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Einstellungen"
                        ToolTip="Einstellungen (Strg + ,)">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{x:Static app:Glyphs.Settings}" />
                </Button>
            </StackPanel>

            <!-- Fenster-Knöpfe. -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource Button.Caption}" Content="{x:Static app:Glyphs.Minimize}"
                        Click="OnMinimizeClick" AutomationProperties.Name="Minimieren" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="{x:Static app:Glyphs.Maximize}"
                        Click="OnMaximizeClick" AutomationProperties.Name="Maximieren" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="{x:Static app:Glyphs.Close}"
                        Click="OnCloseClick" AutomationProperties.Name="Schliessen" />
            </StackPanel>
        </Grid>

        <!-- ================= Tabs ================= -->
        <TabControl Grid.Row="1" Style="{StaticResource TabControl.Main}"
                    ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    AutomationProperties.AutomationId="MainTabs">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItem.Main}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TabViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="14" Margin="0,0,8,0" Text="{Binding Icon}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIconGeometry}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Path Data="{Binding IconGeometry}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Visibility="{Binding HasIconGeometry, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </Grid>
</Window>
