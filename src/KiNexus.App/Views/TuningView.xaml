<UserControl x:Class="KiNexus.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:views="clr-namespace:KiNexus.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TuningViewModel}">

    <!-- Feineinstellungen (Bauplan 8.5): links die KIs, rechts die Werte in drei Gruppen, unten Speichern. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Ein Feld: Name und kurze Erklärung links, Eingabe in der Mitte, Empfehlung oder Fehler rechts. -->
        <DataTemplate x:Key="SettingFieldTemplate" DataType="{x:Type vm:SettingFieldViewModel}">
            <Grid Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding ToolTip}">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Text.Hint}" />
                </StackPanel>
                <TextBox Grid.Column="1" VerticalAlignment="Top" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ToolTip}"
                         AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}"
                         AutomationProperties.AutomationId="{Binding Label, StringFormat='Tuning {0}'}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Hint}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Error}" FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="GroupCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:KiListPanel />

        <!-- Keine KI gewählt -->
        <TextBlock Grid.Column="1" Text="Wähle links eine KI." HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasKi}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Column="1" Visibility="{Binding HasKi, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Kopf: Name der KI und das Grundmodell -->
            <Grid Margin="24,16,24,12" MaxWidth="900" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedKi.DisplayName, StringFormat='Feineinstellungen: {0}'}" FontFamily="{StaticResource Font.UiDisplay}"
                               FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.AutomationId="TuningTitle" />
                    <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource Text.Hint}" AutomationProperties.AutomationId="TuningModelSummary" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="Ollama-Modell aktualisieren" Command="{Binding UpdateOllamaModelCommand}"
                        ToolTip="Erstellt das eigene Ollama-Modell dieser KI neu (Grundmodell + Systemprompt + Werte). So gibt es die KI auch in Open WebUI."
                        Visibility="{Binding IsOllamaKi, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="TuningOllamaUpdate" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="24,0,24,16" MaxWidth="900">

                    <!-- Antwort-Stil -->
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="Antwort-Stil" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,16"
                                       Text="{Binding DefaultsSource, StringFormat='Leeres Feld = Standard. {0}.'}" />
                            <ItemsControl ItemsSource="{Binding SamplingFields}" ItemTemplate="{StaticResource SettingFieldTemplate}" Focusable="False" />
                        </StackPanel>
                    </Border>

                    <!-- Länge und Gedächtnis -->
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="Länge und Gedächtnis" Style="{StaticResource Text.SectionTitle}" AutomationProperties.HeadingLevel="Level3" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent"
                                            ToolTip="Wie viel vom Gespräch die KI auf einmal sieht (in Token, ca. 3/4 Wort). Mehr Kontext braucht mehr VRAM bzw. RAM.">
                                    <TextBlock Text="Kontextlänge" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Wie gross das Gedächtnis ist (mehr braucht mehr Speicher)." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding ContextLengths}" SelectedItem="{Binding ContextLength}"
                                          AutomationProperties.Name="Kontextlänge" AutomationProperties.AutomationId="TuningContext"
                                          ToolTip="Wie viel vom Gespräch die KI auf einmal sieht (in Token, ca. 3/4 Wort). Mehr Kontext braucht mehr VRAM bzw. RAM." />
                                <ContentControl Grid.Column="2" Margin="12,6,0,0" VerticalAlignment="Top" Content="{Binding Fit}" Focusable="False" />
                            </Grid>

                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Text.Hint}" Margin="0,-6,0,10" AutomationProperties.AutomationId="TuningMemory" />

                            <!-- Speicher-Warnung -->
                            <Border Margin="0,0,0,14" Padding="12,8" CornerRadius="{StaticResource Radius.Small}" BorderThickness="1"
                                    Background="{StaticResource Brush.SurfaceLight}"
                                    Visibility="{Binding HasMemoryWarning, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemoryWarningIsSevere}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{x:Static app:Glyphs.Warning}" VerticalAlignment="Top" Margin="0,2,10,0"
                                               Foreground="{StaticResource Brush.Warning}" />
                                    <TextBlock Text="{Binding MemoryWarning}" TextWrapping="Wrap" MaxWidth="720" LineHeight="20"
                                               AutomationProperties.AutomationId="TuningMemoryWarning" AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Border>

                            <ContentControl Content="{Binding MaxTokens}" ContentTemplate="{StaticResource SettingFieldTemplate}" Focusable="False" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent"
                                            ToolTip="Nachdenken (Thinking) macht Antworten bei schwierigen Fragen besser, dauert aber länger. Im Chat kannst du es pro Frage umschalten.">
                                    <TextBlock Text="Thinking (Standard)" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Ob die KI vor der Antwort nachdenkt." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ThinkByDefault}"
                                          Content="Standardmässig nachdenken (nur bei Modellen, die das können)"
                                          AutomationProperties.Name="Thinking standardmässig an" AutomationProperties.AutomationId="TuningThink" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Gespräch (ab M7) -->
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="Gespräch" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,16"
                                       Text="Für den Gespräch-Stil im Chat. Schaltest du den Modus im Gesprächsfenster um, merkt sich die App das für diesen Chat." />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent"
                                            ToolTip="Push-to-Talk: Du hältst eine Taste, solange du sprichst. Freihändig: Die App erkennt selbst, wann du fertig bist, und hört beim Öffnen gleich zu.">
                                    <TextBlock Text="Gespräch startet mit" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Standard-Modus dieser KI, solange ein Chat keinen eigenen hat." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding VoiceModeChoices}" SelectedItem="{Binding VoiceMode}"
                                          AutomationProperties.Name="Gespräch startet mit" AutomationProperties.AutomationId="TuningVoiceMode" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent"
                                            ToolTip="Hörproben aller Stimmen liegen in models\voice\samples\. Eine andere Stimme lädt die App ohne Neustart (ca. 1 Sekunde).">
                                    <TextBlock Text="Stimme" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Mit welcher Stimme diese KI spricht." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding VoiceChoices}" SelectedItem="{Binding Voice}"
                                          AutomationProperties.Name="Stimme" AutomationProperties.AutomationId="TuningVoice" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent"
                                            ToolTip="Ruhig und Langsam lassen die Stimme gelassener klingen. Schneller spart Zeit bei langen Antworten.">
                                    <TextBlock Text="Sprechtempo" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Wie schnell die Stimme spricht." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding TempoChoices}" SelectedItem="{Binding Tempo}"
                                          AutomationProperties.Name="Sprechtempo" AutomationProperties.AutomationId="TuningTempo" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Engine -->
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="Engine" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Text="{Binding EngineHint}" Style="{StaticResource Text.Hint}" Margin="0,0,0,16" />

                            <ItemsControl ItemsSource="{Binding EngineFields}" ItemTemplate="{StaticResource SettingFieldTemplate}" Focusable="False" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent"
                                            ToolTip="Danach entlädt die App das Modell von selbst und gibt VRAM und RAM frei. Das nächste Laden dauert dann wieder einige Sekunden.">
                                    <TextBlock Text="Geladen halten" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Wie lange das Modell nach der letzten Frage im Speicher bleibt." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding KeepAliveChoices}" SelectedItem="{Binding KeepAlive}"
                                          AutomationProperties.Name="Geladen halten" AutomationProperties.AutomationId="TuningKeepAlive"
                                          ToolTip="Danach entlädt die App das Modell von selbst und gibt VRAM und RAM frei." />
                            </Grid>

                            <Grid Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding DraftHint}">
                                    <TextBlock Text="Draft-Modell" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Schneller schreiben mit einem kleinen Hilfsmodell. Braucht mehr VRAM." Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseDraft}" Content="Draft-Modell nutzen"
                                              AutomationProperties.Name="Draft-Modell nutzen" AutomationProperties.AutomationId="TuningDraft"
                                              AutomationProperties.HelpText="{Binding DraftHint}" />
                                    <TextBlock Text="{Binding DraftHint}" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Unten: Meldung und Knöpfe -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Background="{StaticResource Brush.Surface}">
                <Grid Margin="24,10" MaxWidth="900">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Button.Ghost}" Content="Auf Standard zurücksetzen" Command="{Binding ResetToDefaultsCommand}"
                            ToolTip="Setzt die Empfehlungen des Herstellers und die Standards der App ein. Erst mit &quot;Speichern&quot; übernommen."
                            AutomationProperties.AutomationId="TuningReset" />
                    <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="TuningStatus" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Icon}" Command="{Binding DismissStatusCommand}"
                                AutomationProperties.Name="Meldung schliessen" ToolTip="Schliessen">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Close}" />
                        </Button>
                    </Grid>
                    <Button Grid.Column="2" Content="Verwerfen" Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                            ToolTip="Zurück zu den gespeicherten Werten" AutomationProperties.AutomationId="TuningDiscard" />
                    <Button Grid.Column="3" Style="{StaticResource Button.Primary}" Content="Speichern" Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="TuningSave" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
