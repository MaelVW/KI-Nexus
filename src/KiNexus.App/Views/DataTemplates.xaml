<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
                    xmlns:views="clr-namespace:KiNexus.App.Views"
                    xmlns:conv="clr-namespace:KiNexus.App.Converters"
                    xmlns:models="clr-namespace:KiNexus.Core.Models;assembly=KiNexus.Core">

    <!--
        Vorlagen: Welches ViewModel wird wie angezeigt?
        WPF sucht die passende Vorlage über den Typ (DataType).
    -->

    <!-- Karte "Kommt in Meilenstein …" für Bereiche, die noch nicht gebaut sind. -->
    <DataTemplate DataType="{x:Type vm:PlaceholderInfo}">
        <Border Style="{StaticResource Card}" MaxWidth="520" Padding="40,36"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform Y="8" />
            </Border.RenderTransform>
            <Border.Triggers>
                <!-- Ruhiges Einblenden beim Wechsel (200 ms). -->
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel>
                <Grid Width="72" Height="72" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource Brush.AccentSoft}" />
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="30" Text="{Binding Icon}"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Grid>
                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.UiDisplay}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" />
                <Border Margin="0,12,0,0" Padding="12,4" HorizontalAlignment="Center" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.AccentDim}" Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock Text="{Binding MilestoneText}" AutomationProperties.AutomationId="MilestoneText"
                               Foreground="{DynamicResource Brush.Accent}" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding Description}" Margin="0,16,0,0" Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlaceholderTabViewModel}">
        <ContentControl Content="{Binding Placeholder}" Focusable="False" />
    </DataTemplate>

    <!-- Feineinstellungen und System-Prompt (M6). -->
    <DataTemplate DataType="{x:Type vm:TuningViewModel}">
        <views:TuningView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemPromptViewModel}">
        <views:SystemPromptView />
    </DataTemplate>

    <!-- Training (M8). -->
    <DataTemplate DataType="{x:Type vm:TrainingViewModel}">
        <views:TrainingView />
    </DataTemplate>

    <!-- Video (Bauplan Video, V2). -->
    <DataTemplate DataType="{x:Type vm:VideoViewModel}">
        <views:VideoView />
    </DataTemplate>

    <!-- Create-Hub (M3). -->
    <DataTemplate DataType="{x:Type vm:CreateHubViewModel}">
        <views:CreateHubView />
    </DataTemplate>

    <!-- Ampel: farbiger Punkt + kurzer Text, die Erklärung als Tooltip. Ist immer eine Schätzung. -->
    <conv:FitLevelToBrushConverter x:Key="FitLevelToBrush" />
    <DataTemplate DataType="{x:Type models:FitEstimate}">
        <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Explanation}"
                    AutomationProperties.Name="{Binding Label, StringFormat='Ampel: {0}'}" AutomationProperties.HelpText="{Binding Explanation}">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Level, Converter={StaticResource FitLevelToBrush}}" />
            <TextBlock Margin="8,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" />
        </StackPanel>
    </DataTemplate>

    <!-- Chat-Tab: Seitenleiste + Chat (Simpel, Terminal; Gespräch kommt in M4). -->
    <DataTemplate DataType="{x:Type vm:ChatTabViewModel}">
        <views:ChatView />
    </DataTemplate>

</ResourceDictionary>
