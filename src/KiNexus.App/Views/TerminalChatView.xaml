<UserControl x:Class="KiNexus.App.Views.TerminalChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:md="clr-namespace:KiNexus.App.Markdown"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TerminalViewModel}"
             FontFamily="{StaticResource Font.Mono}" FontSize="14">

    <!--
        Terminal-Stil: sieht aus wie ein Windows-Terminal. Es laufen nie echte Shell-Befehle.
        Farben (Bauplan 8.2): Eingabe Cyan (Akzent), Antwort hell, Gedanken grau, Systemmeldungen gelb, Fehler rot.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Nur-Lese-Text in Mono-Schrift: markieren und kopieren geht. -->
        <Style x:Key="TerminalText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:TerminalInputEntry}">
            <TextBlock Margin="0,10,0,4" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}">
                <Run Text="{Binding Prompt, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{Binding Text, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TerminalTextEntry}">
            <TextBox x:Name="text" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource TerminalText}" Foreground="{StaticResource Brush.Warning}" Margin="0,2" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TerminalAnswerEntry}">
            <StackPanel Margin="0,2,0,4">
                <!-- Gedanken: grau und einklappbar. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Message.HasThinking}" Value="True" />
                                        <Condition Binding="{Binding DataContext.Session.ShowThinking, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ToggleButton Style="{StaticResource ToggleButton.Header}" IsChecked="{Binding IsThinkingExpanded}" FontFamily="{StaticResource Font.Mono}"
                                  Content="{Binding Message.ThinkingHeader}" AutomationProperties.Name="Gedanken ein- oder ausklappen" />
                    <TextBox Text="{Binding Message.Thinking, Mode=OneWay}" Style="{StaticResource TerminalText}" Foreground="{StaticResource Brush.TextMuted}"
                             Margin="18,2,0,6" Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <md:MarkdownView Markdown="{Binding DisplayText}" IsStreaming="{Binding ShowCursor}" Flavor="Terminal" />

                <!-- Blinkender Block-Cursor, solange getippt wird. -->
                <TextBlock Text="▌" Foreground="{DynamicResource Brush.Accent}" Visibility="{Binding ShowCursor, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Background}" Margin="20,12,20,16" Padding="16,8,16,8"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Normal}"
            MouseLeftButtonUp="OnTerminalClick">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,6" TextWrapping="Wrap"
                               Text="KI-Nexus Terminal · /help zeigt alle Befehle · Strg + C bricht ab. Es laufen keine echten Shell-Befehle." />
                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" AutomationProperties.AutomationId="TerminalEntries" />
                </StackPanel>
            </ScrollViewer>

            <!-- Eingabezeile -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,8,0" />
                <TextBox x:Name="InputBox" Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource Brush.Accent}"
                         CaretBrush="{DynamicResource Brush.Accent}" TextWrapping="Wrap" AcceptsReturn="False"
                         PreviewKeyDown="OnInputKeyDown" AutomationProperties.Name="Terminal-Eingabe">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>

            <!-- Statuszeile -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,6,0,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="TerminalStatus" />
            </Border>
        </Grid>
    </Border>
</UserControl>
