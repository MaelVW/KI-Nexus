<UserControl x:Class="KiNexus.App.Views.ChatSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatListViewModel}">

    <!-- Einklappbare Seitenleiste mit allen Chats: neu, umbenennen, löschen, suchen. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
        <Grid>
            <!-- Eingeklappt: schmale Leiste mit zwei Knöpfen. -->
            <StackPanel Width="48" Margin="0,10,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Style="{StaticResource Button.Icon}" Width="36" Height="36" Content="{x:Static app:Glyphs.Sidebar}"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="Chats anzeigen" AutomationProperties.Name="Chats anzeigen" />
                <Button Style="{StaticResource Button.Icon}" Width="36" Height="36" Margin="0,6,0,0" Content="{x:Static app:Glyphs.Add}"
                        Command="{Binding NewChatCommand}" ToolTip="Neuer Chat (Strg + N)" AutomationProperties.Name="Neuer Chat" />
            </StackPanel>

            <!-- Offen -->
            <Grid Width="260" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="12,10,10,6">
                    <TextBlock Text="Chats" VerticalAlignment="Center" FontFamily="{StaticResource Font.UiDisplay}" FontWeight="SemiBold" Margin="4,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Add}" Command="{Binding NewChatCommand}"
                                ToolTip="Neuer Chat (Strg + N)" AutomationProperties.Name="Neuer Chat" />
                        <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Sidebar}" Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Seitenleiste einklappen" AutomationProperties.Name="Seitenleiste einklappen" />
                    </StackPanel>
                </Grid>

                <!-- Suche, mit Platzhalter-Text, solange das Feld leer ist. -->
                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6"
                             AutomationProperties.Name="Chats suchen" />
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Search}" HorizontalAlignment="Left"
                               Margin="10,0,0,0" Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False" />
                    <TextBlock Text="Suchen …" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Brush.TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ListBox Grid.Row="2" Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListBoxItem.Card}"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Padding="8,0,8,8"
                         AutomationProperties.Name="Chat-Liste" KeyDown="OnListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatListItem}">
                            <Grid x:Name="row" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="editor" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                             Padding="4,2" KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus"
                                             IsVisibleChanged="OnRenameVisible" AutomationProperties.Name="Neuer Name" />
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Hidden">
                                    <Button Style="{StaticResource Button.Icon}" Width="26" Content="{x:Static app:Glyphs.Rename}" FontSize="12"
                                            Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Umbenennen (F2)" AutomationProperties.Name="Umbenennen" />
                                    <Button Style="{StaticResource Button.Icon}" Width="26" Content="{x:Static app:Glyphs.Delete}" FontSize="12"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Löschen (Entf)" AutomationProperties.Name="Löschen" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="actions" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="actions" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter TargetName="title" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="editor" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="actions" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Margin="20" TextWrapping="Wrap" Style="{StaticResource Text.Hint}" TextAlignment="Center"
                           Text="Noch keine Chats. Stell rechts eine Frage, dann erscheint der Chat hier."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
