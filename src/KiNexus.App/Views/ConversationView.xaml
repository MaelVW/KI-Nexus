<UserControl x:Class="KiNexus.App.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:md="clr-namespace:KiNexus.App.Markdown"
             xmlns:conv="clr-namespace:KiNexus.App.Converters"
             xmlns:kis="clr-namespace:KiNexus.Core.Kis;assembly=KiNexus.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConversationViewModel}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp"
             Loaded="OnLoaded" IsVisibleChanged="OnIsVisibleChanged">

    <!--
        Gespräch-Stil: oben der Schalter Push-to-Talk | Freihändig, in der Mitte der Orb, darunter die Mitschrift.
        Der Orb zeigt den Zustand: zuhören (pulsiert), verstehen und denken (Ring dreht sich), sprechen (wächst mit der Stimme).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.12" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.12" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="Spin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RingRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2.4" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modus und Mikrofon -->
        <DockPanel Grid.Row="0" Margin="24,16,24,0">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Text.Hint}" Margin="12,0,0,0"
                       Text="{Binding MicrophoneName, StringFormat='Mikrofon: {0}'}"
                       Visibility="{Binding MicrophoneName, Converter={StaticResource NullToVisibility}}" />
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="voiceMode" Content="Push-to-Talk"
                                 AutomationProperties.AutomationId="ModePushToTalk" Focusable="False"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static kis:VoiceMode.PushToTalk}}" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="voiceMode" Content="Freihändig"
                                 AutomationProperties.AutomationId="ModeHandsFree" Focusable="False"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static kis:VoiceMode.HandsFree}}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Orb -->
        <StackPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center">
            <Grid x:Name="Orb" Width="240" Height="240" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="OnOrbDown" MouseLeftButtonUp="OnOrbUp" LostMouseCapture="OnOrbLostCapture"
                  AutomationProperties.AutomationId="Orb" AutomationProperties.Name="{Binding StateText, StringFormat='Orb: {0}'}"
                  ToolTip="{Binding ModeHint}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConversationState.Off}">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConversationState.Ready}">
                                <Setter Property="Opacity" Value="0.75" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Schein aussen: pulsiert beim Zuhören -->
                <Ellipse x:Name="Halo" Width="230" Height="230" RenderTransformOrigin="0.5,0.5" Opacity="0.45">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="HaloScale" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Color.Accent}" Offset="0.45" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Ring: dreht sich beim Verstehen und Denken -->
                <Ellipse Width="200" Height="200" StrokeThickness="2.5" StrokeDashArray="3 5" RenderTransformOrigin="0.5,0.5"
                         Stroke="{DynamicResource Brush.Accent}">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RingRotation" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConversationState.Understanding}">
                                    <Setter Property="Opacity" Value="0.9" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConversationState.Thinking}">
                                    <Setter Property="Opacity" Value="0.9" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConversationState.Starting}">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Kern: wächst mit der Lautstärke (Mikrofon oder Stimme der KI) -->
                <Ellipse x:Name="Core" Width="150" Height="150" RenderTransformOrigin="0.5,0.5" Effect="{DynamicResource Effect.Glow}">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="{Binding OrbScale}" ScaleY="{Binding OrbScale}" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                                        <GradientStop Color="White" Offset="0" />
                                        <GradientStop Color="{DynamicResource Color.Accent}" Offset="0.45" />
                                        <GradientStop Color="{DynamicResource Color.AccentDim}" Offset="1" />
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ConversationState.Error}">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Style="{StaticResource Text.Icon}" FontSize="34" Text="{x:Static app:Glyphs.Microphone}"
                           Foreground="{StaticResource Brush.OnAccent}" Opacity="0.85" IsHitTestVisible="False" />
            </Grid>

            <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="{StaticResource FontSize.Large}"
                       AutomationProperties.AutomationId="ConversationState" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding InfoText}" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource Text.Hint}"
                       AutomationProperties.AutomationId="ConversationInfo" />
            <TextBlock Text="{Binding Session.StatusText}" HorizontalAlignment="Center" Margin="0,2,0,0" Style="{StaticResource Text.Hint}" />
            <Border Margin="24,10,24,0" Padding="14,10" MaxWidth="640" CornerRadius="{StaticResource Radius.Normal}"
                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Error}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConversationError" />
            </Border>
        </StackPanel>

        <!-- Mitschrift -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Padding="24,0,18,0"
                      ScrollChanged="OnScrollChanged" Focusable="False">
            <ItemsControl ItemsSource="{Binding Session.Messages}" MaxWidth="820" Focusable="False" AutomationProperties.Name="Mitschrift">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSize.Small}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding KiName, TargetNullValue='KI'}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Text" Value="Du" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <md:MarkdownView Markdown="{Binding Content}" IsStreaming="{Binding IsStreaming}" Flavor="Bubble" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fuss: Hinweis und Unterbrechen -->
        <Grid Grid.Row="3" Margin="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Margin="0" />
            <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding InterruptCommand}" Focusable="False"
                    AutomationProperties.AutomationId="ConversationInterrupt" ToolTip="Antwort und Stimme sofort stoppen (Esc)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Stop}" />
                    <TextBlock Text="Unterbrechen" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
