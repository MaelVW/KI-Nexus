<UserControl x:Class="KiNexus.App.Views.KiListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:kis="clr-namespace:KiNexus.Core.Kis;assembly=KiNexus.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KiEditorTabViewModel}">

    <!-- Links in den Tabs "System-Prompt" und "Feineinstellungen": die Liste meiner KIs. -->
    <Border Width="260" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Meine KIs" Margin="16,14,12,8" FontFamily="{StaticResource Font.UiDisplay}" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2" />
            <ListBox ItemsSource="{Binding Kis}" SelectedItem="{Binding SelectedKi}" Style="{StaticResource ListBox.Plain}" Margin="8,0,8,8"
                     ItemContainerStyle="{StaticResource ListBoxItem.Card}" AutomationProperties.Name="Meine KIs"
                     AutomationProperties.AutomationId="EditorKiList">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type kis:KiProfile}">
                        <StackPanel AutomationProperties.Name="{Binding DisplayName}">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding EngineLabel}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
