<UserControl x:Class="KiNexus.App.Views.SystemPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:views="clr-namespace:KiNexus.App.Views"
             xmlns:kis="clr-namespace:KiNexus.Core.Kis;assembly=KiNexus.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SystemPromptViewModel}">

    <!-- System-Prompt (Bauplan 8.4): links die KIs, in der Mitte der Editor mit Test-Chat, rechts die alten Fassungen. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <views:KiListPanel />

        <!-- Keine KI gewählt -->
        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Wähle links eine KI." HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasKi}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Editor -->
        <Grid Grid.Column="1" Margin="24,16,16,0" Visibility="{Binding HasKi, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedKi.DisplayName, StringFormat='System-Prompt: {0}'}" FontFamily="{StaticResource Font.UiDisplay}"
                               FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.AutomationId="PromptTitle" />
                    <TextBlock Text="{Binding TokenText}" Style="{StaticResource Text.Hint}" AutomationProperties.AutomationId="PromptTokens" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="Ollama-Modell aktualisieren" Command="{Binding UpdateOllamaModelCommand}"
                        ToolTip="Erstellt das eigene Ollama-Modell dieser KI neu (Grundmodell + gespeicherter Systemprompt + Werte). So gibt es die KI auch in Open WebUI."
                        Visibility="{Binding IsOllamaKi, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="PromptOllamaUpdate" />
            </Grid>

            <!-- Vorlagen: werden an der Stelle des Cursors eingefügt. -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <!-- Eigene Vorlage: den Prompt im Editor unter einem Namen speichern. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox Width="220" Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Name der eigenen Vorlage" AutomationProperties.AutomationId="PromptTemplateName"
                             ToolTip="Name der eigenen Vorlage, z.B. „Bewerbungen“" />
                    <Button Content="Als eigene Vorlage speichern" Command="{Binding SaveAsTemplateCommand}" Margin="8,0,12,0"
                            AutomationProperties.AutomationId="PromptSaveTemplate"
                            ToolTip="Speichert den Prompt im Editor als Vorlage. Sie steht danach bei allen KIs zur Auswahl." />
                    <TextBlock Text="{Binding TemplateStatus}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               AutomationProperties.AutomationId="PromptTemplateStatus" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="Vorlage einfügen:" Style="{StaticResource Text.Muted}" VerticalAlignment="Top" Margin="0,7,10,8" />
                <ItemsControl ItemsSource="{Binding Templates}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type kis:PromptTemplate}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                <Button Content="{Binding Name}" Click="OnInsertTemplate"
                                        ToolTip="{Binding Text}" AutomationProperties.Name="{Binding Name, StringFormat='Vorlage {0} einfügen'}" />
                                <!-- Eigene Vorlagen kann man löschen. -->
                                <Button Style="{StaticResource Button.Icon}" Margin="2,0,0,0" ToolTip="Eigene Vorlage löschen"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Vorlage {0} löschen'}">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="11" Text="{x:Static app:Glyphs.Close}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <TextBox x:Name="PromptEditor" Grid.Row="2" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" Padding="10,8"
                     AutomationProperties.Name="Systemprompt" AutomationProperties.AutomationId="PromptEditor" />

            <!-- Kurzer Test mit dem Prompt aus dem Editor. Wird nicht gespeichert. -->
            <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14" BorderBrush="{DynamicResource Brush.AccentDim}" BorderThickness="1"
                    Visibility="{Binding IsTestOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Kurzer Test" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock Text="{Binding TestStatus}" Style="{StaticResource Text.Hint}" AutomationProperties.AutomationId="PromptTestStatus"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.Ghost}" Content="Leeren" Command="{Binding ClearTestCommand}" Margin="0,0,6,0"
                                    ToolTip="Test-Chat leeren" AutomationProperties.AutomationId="PromptTestClear" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding CloseTestCommand}" ToolTip="Test schliessen"
                                    AutomationProperties.Name="Test schliessen" AutomationProperties.AutomationId="PromptTestClose">
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Close}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="TestScroll" Grid.Row="1" MaxHeight="240" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnTestScrollChanged" Focusable="False">
                        <ItemsControl ItemsSource="{Binding TestMessages}" Focusable="False" AutomationProperties.Name="Test-Chat"
                                      AutomationProperties.AutomationId="PromptTestMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TestMessageViewModel}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Small}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Schreibgeschützte Textbox: So kann man die Antwort markieren und kopieren. -->
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0,2"
                                                 Background="Transparent" AutomationProperties.Name="{Binding Sender}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TestInput" Text="{Binding TestInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Testfrage" AutomationProperties.AutomationId="PromptTestInput">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendTestCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding SendTestCommand}" ToolTip="Senden (Enter)"
                                    AutomationProperties.Name="Testfrage senden" AutomationProperties.AutomationId="PromptTestSend">
                                <TextBlock Text="Senden" />
                            </Button>
                            <Button Command="{Binding StopTestCommand}" ToolTip="Antwort stoppen" Margin="8,0,0,0"
                                    AutomationProperties.Name="Test stoppen" AutomationProperties.AutomationId="PromptTestStop"
                                    Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Stopp" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Unten: Meldung und Knöpfe -->
            <Grid Grid.Row="4" Margin="0,12,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="PromptStatus" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Icon}" Command="{Binding DismissStatusCommand}"
                            AutomationProperties.Name="Meldung schliessen" ToolTip="Schliessen">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Close}" />
                    </Button>
                </Grid>
                <Button Grid.Column="1" Content="Testen" Command="{Binding OpenTestCommand}" Margin="0,0,8,0"
                        ToolTip="Kurzer Test-Chat mit dem Prompt aus dem Editor, auch wenn er noch nicht gespeichert ist"
                        AutomationProperties.AutomationId="PromptTest" />
                <Button Grid.Column="2" Content="Verwerfen" Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                        ToolTip="Zurück zum gespeicherten Prompt" AutomationProperties.AutomationId="PromptDiscard" />
                <Button Grid.Column="3" Style="{StaticResource Button.Primary}" Content="Speichern" Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="PromptSave" />
            </Grid>
        </Grid>

        <!-- Versionen -->
        <Border Grid.Column="2" Width="300" Margin="0,16,24,14" Style="{StaticResource Card}" Padding="14"
                Visibility="{Binding HasKi, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Versionen" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding VersionsHint}" Style="{StaticResource Text.Hint}" Margin="0,4,0,10" />
                <ListBox ItemsSource="{Binding Versions}" Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListBoxItem.Card}"
                         AutomationProperties.Name="Alte Fassungen" AutomationProperties.AutomationId="PromptVersions">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PromptVersionItem}">
                            <Grid AutomationProperties.Name="{Binding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel ToolTip="{Binding Version.Content}">
                                    <TextBlock Text="{Binding DateText}" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Icon}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RestoreVersionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        ToolTip="In den Editor holen (danach speichern)" AutomationProperties.Name="Diese Fassung wiederherstellen">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Refresh}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
