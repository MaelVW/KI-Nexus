<UserControl x:Class="KiNexus.App.Views.CreateHubOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:conv="clr-namespace:KiNexus.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CreateHubOverviewViewModel}">

    <!-- Übersicht: Meine KIs, Grundmodelle, Ollama-Modelle. Jede Zeile mit Ampel und Knöpfen. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Normal}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <!-- Kleiner Icon-Knopf (Löschen, Ordner). Das Icon steht als TextBlock im Knopf, siehe Hinweis unten. -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>

        <!--
            Knopf-Texte als TextBlock statt als Text: Sonst entfernt WPF für Screenreader die Unterstriche
            aus dem Namen ("q8_0" würde zu "q80"), weil es sie für Tastenkürzel hält.
        -->
        <TextBlock x:Key="Label.NewKi" x:Shared="False" Text="Neue KI daraus" />
        <TextBlock x:Key="Label.TestLoad" x:Shared="False" Text="Ladetest" />

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,4,18,24">
        <StackPanel Margin="0,0,6,0" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Meine KIs -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Refresh}"
                        Command="{Binding RefreshCommand}" ToolTip="Neu laden" AutomationProperties.Name="Übersicht neu laden" />
                <TextBlock Text="Meine KIs" Style="{StaticResource SectionHeader}" Margin="0,12,0,10" />
            </DockPanel>
            <TextBlock Text="Noch keine KI. Erstelle eine unter &quot;Neue KI&quot;." Style="{StaticResource Text.Muted}"
                       Visibility="{Binding HasNoKis, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding KiRows}" Focusable="False" AutomationProperties.Name="Meine KIs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KiRow}">
                        <Border Style="{StaticResource Row}" AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BaseModelText}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}"
                                               TextTrimming="CharacterEllipsis" ToolTip="Grundmodell" />
                                </StackPanel>
                                <ContentControl Grid.Column="1" Content="{Binding Fit}" Focusable="False" VerticalAlignment="Center"
                                                Visibility="{Binding Fit, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock Grid.Column="2" Text="{Binding EngineText}" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Text.Muted}"
                                           Text="{Binding ImagesText, StringFormat='Bilder: {0}'}" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.ChatWithCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Mit {0} chatten'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Chat}" />
                                            <TextBlock Text="Chatten" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeleteButton}" ToolTip="KI löschen"
                                            Command="{Binding DataContext.DeleteKiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} löschen'}">
                                        <TextBlock Text="{x:Static app:Glyphs.Delete}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Grundmodelle -->
            <TextBlock Text="Grundmodelle" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Die Ampel ist eine Schätzung: Dateigrösse plus Puffer für 8192 Token Kontext, verglichen mit dem VRAM der Grafikkarte und einem Teil des RAM. Fahre mit der Maus darüber für die Zahlen."
                       Style="{StaticResource Text.Hint}" Margin="0,-4,0,10" />
            <TextBlock Text="Noch keine Grundmodelle. Importiere eine GGUF-Datei oder lade eine von Hugging Face." Style="{StaticResource Text.Muted}"
                       Visibility="{Binding HasNoModels, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding ModelRows}" Focusable="False" AutomationProperties.Name="Grundmodelle">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModelRow}">
                        <Border Style="{StaticResource Row}" AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UsedByText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding LicenseText, StringFormat='Lizenz: {0}'}" />
                                    <TextBlock Foreground="{StaticResource Brush.Error}" FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap"
                                               Text="{Binding KindWarning}" Visibility="{Binding HasKindWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Foreground="{DynamicResource Brush.Accent}" FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap"
                                               Text="{Binding VideoNote}" Visibility="{Binding IsUsableInStudio, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <!-- Die Ampel gilt für Sprachmodelle. Für Videos schätzt der Video-Tab selbst. -->
                                <ContentControl Grid.Column="1" Content="{Binding Fit}" Focusable="False" VerticalAlignment="Center"
                                                Visibility="{Binding IsLanguageModel, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding QuantText}" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" ToolTip="Quantisierung (Stufe der Verkleinerung)" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{Binding ImagesText, StringFormat='Bilder: {0}'}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Button Style="{StaticResource RowButton}" Content="{StaticResource Label.NewKi}"
                                            Visibility="{Binding IsLanguageModel, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.NewKiFromCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Neue KI aus {0}'}" />
                                    <Button Style="{StaticResource RowButton}" Content="{StaticResource Label.TestLoad}" ToolTip="Prüft, ob llama.cpp das Modell laden kann (lädt kurz und entlädt wieder)."
                                            Visibility="{Binding IsLanguageModel, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.TestLoadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Ladetest für {0}'}" />
                                    <Button Style="{StaticResource RowButton}" ToolTip="Wechselt ins Studio und wählt dort dieses Modell."
                                            Visibility="{Binding IsUsableInStudio, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.UseInVideoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} im Studio nutzen'}">
                                        <TextBlock Text="Im Studio nutzen" />
                                    </Button>
                                    <Button Style="{StaticResource DeleteButton}" Margin="8,0,0,0" ToolTip="Ordner öffnen"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Ordner von {0} öffnen'}">
                                        <TextBlock Text="{x:Static app:Glyphs.Folder}" />
                                    </Button>
                                    <Button Style="{StaticResource DeleteButton}" ToolTip="Grundmodell löschen"
                                            Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} löschen'}">
                                        <TextBlock Text="{x:Static app:Glyphs.Delete}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ollama-Modelle -->
            <TextBlock Text="Ollama-Modelle" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="{Binding OllamaStatus}" Style="{StaticResource Text.Hint}" Margin="0,-4,0,10" AutomationProperties.AutomationId="OllamaStatus" />
            <ItemsControl ItemsSource="{Binding OllamaRows}" Focusable="False" AutomationProperties.Name="Ollama-Modelle"
                          Visibility="{Binding IsOllamaRunning, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OllamaRow}">
                        <Border Style="{StaticResource Row}" AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Grid.Column="1" Content="{Binding Fit}" Focusable="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Style="{StaticResource RowButton}" Content="{StaticResource Label.NewKi}"
                                            Command="{Binding DataContext.NewKiFromOllamaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Neue KI aus {0}'}" />
                                    <Button Style="{StaticResource DeleteButton}" ToolTip="In Ollama löschen"
                                            Command="{Binding DataContext.DeleteOllamaModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} in Ollama löschen'}">
                                        <TextBlock Text="{x:Static app:Glyphs.Delete}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
