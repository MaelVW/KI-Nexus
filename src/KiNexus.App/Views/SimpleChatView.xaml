<UserControl x:Class="KiNexus.App.Views.SimpleChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:KiNexus.App"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:md="clr-namespace:KiNexus.App.Markdown"
             xmlns:conv="clr-namespace:KiNexus.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatSessionViewModel}"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <!-- Simpel-Stil: Nachrichten als Blasen, wie in Open WebUI oder ChatGPT. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:PathToThumbnailConverter x:Key="Thumbnail" />
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />

        <!-- Nur-Lese-Text ohne Rahmen (eigene Nachrichten): markieren und kopieren geht. -->
        <Style x:Key="PlainText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bild-Vorschau (angehängt oder in einer Nachricht). -->
        <DataTemplate x:Key="ImageThumb">
            <Button Margin="0,0,8,8" Padding="0" Cursor="Hand" ToolTip="Bild öffnen"
                    Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="{StaticResource Radius.Small}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                            <Image Source="{Binding Converter={StaticResource Thumbnail}}" MaxHeight="160" MaxWidth="220" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Verlauf ================= -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged" Focusable="False">
            <ItemsControl ItemsSource="{Binding Messages}" Margin="24,16,24,8" MaxWidth="900" Focusable="False"
                          AutomationProperties.AutomationId="Messages">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                        <Grid Margin="0,0,0,16">
                            <!-- Eigene Nachricht: rechts, im Akzent getönt. -->
                            <StackPanel HorizontalAlignment="Right" MaxWidth="680" Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageThumb}" HorizontalAlignment="Right"
                                              Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentDim}" BorderThickness="1"
                                        CornerRadius="12,12,4,12" Padding="14,9" HorizontalAlignment="Right">
                                    <TextBox Style="{StaticResource PlainText}" Text="{Binding Content, Mode=OneWay}" AutomationProperties.Name="Meine Nachricht" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Edit}" ToolTip="Bearbeiten und neu senden"
                                            AutomationProperties.Name="Bearbeiten"
                                            Command="{Binding DataContext.EditLastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding IsLastUser, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Copy}" ToolTip="Kopieren" AutomationProperties.Name="Kopieren"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Antwort der KI: links, ohne Blase, mit Markdown. -->
                            <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding KiName}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSize.Small}"
                                           FontWeight="SemiBold" Margin="0,0,0,4" />

                                <!-- Gedanken: einklappbar, "Nachgedacht für X Sekunden". -->
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasThinking}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.ShowThinking, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ToggleButton Style="{StaticResource ToggleButton.Header}" IsChecked="{Binding IsThinkingExpanded}"
                                                  AutomationProperties.Name="Gedanken ein- oder ausklappen">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Lightbulb}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ThinkingHeader}" FontSize="{StaticResource FontSize.Small}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Border Margin="18,6,0,0" Padding="12,4,0,4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="2,0,0,0"
                                            Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Style="{StaticResource PlainText}" Text="{Binding Thinking, Mode=OneWay}" FontSize="13"
                                                 Foreground="{StaticResource Brush.TextMuted}" AutomationProperties.AutomationId="ThinkingText" />
                                    </Border>
                                </StackPanel>

                                <!-- Pünktchen, solange noch kein Text da ist. -->
                                <TextBlock Text="●  ●  ●" Foreground="{DynamicResource Brush.Accent}" FontSize="10" Margin="0,4,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsStreaming}" Value="True" />
                                                        <Condition Binding="{Binding Content}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="pulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="pulse" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <md:MarkdownView Markdown="{Binding DisplayContent}" IsStreaming="{Binding IsStreaming}" Flavor="Bubble"
                                                 AutomationProperties.AutomationId="AnswerText" />

                                <!-- Knöpfe pro Antwort: kopieren, neu erzeugen, bewerten, Info. -->
                                <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Copy}" ToolTip="Kopieren" AutomationProperties.Name="Antwort kopieren"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Refresh}" ToolTip="Neu erzeugen" AutomationProperties.Name="Neu erzeugen"
                                            Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding IsLastAssistant, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{x:Static app:Glyphs.Like}" ToolTip="Gute Antwort" AutomationProperties.Name="Daumen hoch"
                                            Command="{Binding DataContext.RateUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{x:Static app:Glyphs.Dislike}" ToolTip="Schlechte Antwort" AutomationProperties.Name="Daumen runter"
                                            Command="{Binding DataContext.RateDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource Button.Icon}" Content="{x:Static app:Glyphs.Info}" ToolTip="Statistik" AutomationProperties.Name="Statistik"
                                            Command="{Binding DataContext.ToggleStatsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding StatsText}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="6,0,0,0" AutomationProperties.AutomationId="StatsText"
                                               Visibility="{Binding ShowStats, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Leerer Chat -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMessages}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource Brush.AccentSoft}" />
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="26" Text="{x:Static app:Glyphs.Bubbles}" Foreground="{DynamicResource Brush.Accent}" />
            </Grid>
            <TextBlock Text="Worüber möchtest du reden?" Margin="0,16,0,4" HorizontalAlignment="Center"
                       FontFamily="{StaticResource Font.UiDisplay}" FontSize="{StaticResource FontSize.Large}" FontWeight="SemiBold" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{Binding Ki.DisplayName, StringFormat='Es antwortet: {0}'}" />
        </StackPanel>

        <!-- ================= Eingabe ================= -->
        <Border Grid.Row="1" Margin="24,0,24,16" MaxWidth="900">
            <StackPanel>
                <!-- Status, Fehler, Kontext-Hinweis -->
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Accent}" FontSize="{StaticResource FontSize.Small}" Margin="4,0,0,4"
                           AutomationProperties.AutomationId="StatusText" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Margin="4,0,0,6"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ErrorText" />
                <TextBlock Text="{Binding ContextHint}" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Margin="4,0,0,6" FontSize="{StaticResource FontSize.Small}"
                           Visibility="{Binding HasContextHint, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ContextHint" />

                <!-- Bearbeiten-Modus -->
                <Border Padding="12,6" Margin="0,0,0,6" CornerRadius="{StaticResource Radius.Small}" Background="{StaticResource Brush.SurfaceLight}"
                        Visibility="{Binding IsEditingLast, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="Du bearbeitest deine letzte Nachricht. Senden ersetzt sie und die Antwort darauf." Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" FontSize="{StaticResource FontSize.Small}" />
                        <Button Content="Abbrechen" HorizontalAlignment="Right" Style="{StaticResource Button.Ghost}" Padding="8,2" Command="{Binding CancelEditCommand}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="12" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Angehängte Bilder -->
                        <ItemsControl ItemsSource="{Binding PendingImages}" Margin="4,2,0,4" AutomationProperties.AutomationId="PendingImages">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,4">
                                        <Border CornerRadius="{StaticResource Radius.Small}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                            <Image Source="{Binding Converter={StaticResource Thumbnail}}" Height="64" MaxWidth="120" Stretch="Uniform" />
                                        </Border>
                                        <Button Style="{StaticResource Button.Icon}" Width="22" Height="22" FontSize="9" Content="{x:Static app:Glyphs.Close}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Brush.Surface}" ToolTip="Entfernen"
                                                AutomationProperties.Name="Bild entfernen"
                                                Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox x:Name="InputBox" Grid.Row="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" MinHeight="40" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="6,8" FontSize="15" BorderThickness="0" Background="Transparent"
                                 PreviewKeyDown="OnInputKeyDown" AutomationProperties.Name="Nachricht"
                                 ToolTip="Enter = senden, Shift + Enter = neue Zeile, Esc = abbrechen" />
                        <!-- Platzhalter, solange das Feld leer ist. -->
                        <TextBlock Grid.Row="1" Margin="8,9,0,0" IsHitTestVisible="False" FontSize="15" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="{Binding Ki.DisplayName, StringFormat='Nachricht an {0} …'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- +-Knopf für Bilder. Ohne Bild-Unterstützung grau, der Hinweis erklärt warum. -->
                                <Button Style="{StaticResource Button.Icon}" Width="34" Height="32" FontSize="15" Content="{x:Static app:Glyphs.Add}"
                                        Command="{Binding AttachImagesCommand}" IsEnabled="{Binding CanAttachImages}"
                                        ToolTip="{Binding AttachHint}" AutomationProperties.Name="Bild anhängen" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Thinking" IsChecked="{Binding ThinkEnabled}" Margin="10,0,0,0"
                                          AutomationProperties.Name="Thinking" ToolTip="Die KI denkt vor der Antwort nach. Gilt für diesen Chat." />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Gedanken zeigen" IsChecked="{Binding ShowThinking}" Margin="16,0,0,0"
                                          AutomationProperties.Name="Gedanken zeigen" />
                            </StackPanel>

                            <!-- Kontext-Anzeige: wie viel vom Gedächtnis belegt ist. -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"
                                        ToolTip="Kontext (Gedächtnis des Modells): belegt / gesamt. Wird er voll, fallen die ältesten Nachrichten weg.">
                                <TextBlock Text="{Binding ContextText}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                           HorizontalAlignment="Right" AutomationProperties.AutomationId="ContextText" />
                                <Grid Width="120" Height="3" Margin="0,3,0,0" HorizontalAlignment="Right">
                                    <Border Background="{StaticResource Brush.Border}" CornerRadius="2" />
                                    <Border Background="{DynamicResource Brush.AccentDim}" CornerRadius="2" HorizontalAlignment="Left"
                                            Width="{Binding ContextFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=120}" />
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <Button Command="{Binding SendCommand}" Style="{StaticResource Button.Primary}" Padding="16,7" AutomationProperties.Name="Senden"
                                        ToolTip="Senden (Enter)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{x:Static app:Glyphs.Send}" />
                                        <TextBlock Text="Senden" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopCommand}" Padding="16,7" BorderBrush="{StaticResource Brush.Error}" AutomationProperties.Name="Stopp"
                                        ToolTip="Antwort abbrechen (Esc)" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Stop}" Foreground="{StaticResource Brush.Error}" />
                                        <TextBlock Text="Stopp" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
