<UserControl x:Class="KiNexus.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KiNexus.App.ViewModels"
             xmlns:views="clr-namespace:KiNexus.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatTabViewModel}">

    <!-- Der Chat-Tab: links die Chats, rechts ein Chat in einem von drei Stilen. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:ChatSidebarView DataContext="{Binding ChatList}" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hinweis, z.B. "Modell fehlt" oder "Ollama läuft nicht". -->
            <Border Margin="20,12,20,0" Padding="14,10" CornerRadius="{StaticResource Radius.Normal}"
                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    DataContext="{Binding Session.Readiness}"
                    Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}"
                                   AutomationProperties.AutomationId="EngineHint" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Hint}" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="12,0,0,0" Content="Aus Ollama übernehmen" Style="{StaticResource Button.Primary}"
                            Command="{Binding ImportFromOllamaCommand}"
                            Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Legt einen Hardlink an: zweiter Dateiname für dieselben Daten. Braucht keinen Platz, Ollama-Dateien bleiben unverändert." />
                </Grid>
            </Border>

            <views:SimpleChatView Grid.Row="1" DataContext="{Binding Session}"
                                  Visibility="{Binding DataContext.IsSimple, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
            <views:TerminalChatView Grid.Row="1" DataContext="{Binding Terminal}"
                                    Visibility="{Binding DataContext.IsTerminal, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
            <views:ConversationView Grid.Row="1" DataContext="{Binding Conversation}"
                                    Visibility="{Binding DataContext.IsConversation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
