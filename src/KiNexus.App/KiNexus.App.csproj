<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Die .exe heisst KI-Nexus.exe, der Namespace bleibt KiNexus.App. -->
    <AssemblyName>KI-Nexus</AssemblyName>
    <RootNamespace>KiNexus.App</RootNamespace>
    <ApplicationIcon>Assets\KiNexus.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\KiNexus.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KiNexus.Core\KiNexus.Core.csproj" />
    <ProjectReference Include="..\KiNexus.Engines\KiNexus.Engines.csproj" />
  </ItemGroup>

  <!-- Privates Modul (Fun-Tab): Gibt es den Ordner privat\KiNexus.Fun, wird es nach der App gebaut und neben die App gelegt.
       Im öffentlichen Repository fehlt der Ordner, dann passiert hier nichts. -->
  <PropertyGroup>
    <FunProject>$(MSBuildThisFileDirectory)..\..\privat\KiNexus.Fun\KiNexus.Fun.csproj</FunProject>
  </PropertyGroup>
  <Target Name="BuildFunModule" AfterTargets="Build" Condition="Exists('$(FunProject)') And '$(BuildingFunModule)' != 'true'">
    <MSBuild Projects="$(FunProject)" Targets="Restore" Properties="Configuration=$(Configuration);AppOutDir=$(ProjectDir)$(OutDir);BuildingFunModule=true;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(FunProject)" Targets="Build" Properties="Configuration=$(Configuration);AppOutDir=$(ProjectDir)$(OutDir);BuildingFunModule=true" />
  </Target>

</Project>
