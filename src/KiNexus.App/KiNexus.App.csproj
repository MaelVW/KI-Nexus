<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Die .exe heisst KI-Nexus.exe, der Namespace bleibt KiNexus.App. -->
    <AssemblyName>KI-Nexus</AssemblyName>
    <RootNamespace>KiNexus.App</RootNamespace>
    <ApplicationIcon>Assets\KiNexus.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\KiNexus.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- Avatar (Erweiterung E3): die Web-Dateien aus dem Testpanel, neben die App kopiert. Die Quellen in src/ braucht nur, wer neu bündelt. -->
  <ItemGroup>
    <None Include="Avatar\web\**\*" Exclude="Avatar\web\src\**;Avatar\web\build.cjs;Avatar\web\package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KiNexus.Core\KiNexus.Core.csproj" />
    <ProjectReference Include="..\KiNexus.Engines\KiNexus.Engines.csproj" />
  </ItemGroup>

</Project>
