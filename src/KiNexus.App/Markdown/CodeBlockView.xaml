<UserControl x:Class="KiNexus.App.Markdown.CodeBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:app="clr-namespace:KiNexus.App">
    <!-- Ein Codeblock: oben Sprache und Kopier-Knopf, darunter der Code mit Syntax-Farben (AvalonEdit, nur lesen). -->
    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Normal}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.SurfaceLight}" CornerRadius="7,7,0,0" Padding="12,4,4,4">
                <Grid>
                    <TextBlock x:Name="LanguageText" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                               FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                    <Button x:Name="CopyButton" HorizontalAlignment="Right" Style="{StaticResource Button.Ghost}" Padding="8,3"
                            Click="OnCopyClick" ToolTip="Code kopieren" AutomationProperties.Name="Code kopieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{x:Static app:Glyphs.Copy}" />
                            <TextBlock x:Name="CopyText" Text="Kopieren" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <avalon:TextEditor x:Name="Editor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="False" WordWrap="False"
                               FontFamily="{StaticResource Font.Mono}" FontSize="13" Padding="12,10"
                               Background="Transparent" Foreground="{StaticResource Brush.Text}"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" />
        </Grid>
    </Border>
</UserControl>
