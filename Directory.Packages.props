<Project>
  <!-- Alle NuGet-Versionen an einem Ort (Central Package Management).
       In den .csproj-Dateien steht nur der Paketname, ohne Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="App">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Core und Engines">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Windows DPAPI: Hugging-Face-Token verschlüsselt speichern. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- Wiedergabe der Sprachausgabe. 2.4.0 ist die letzte der stabilen 2er-Reihe. Die 3er-Reihe (seit August 2026)
         hat sich seither mehrmals stark geändert, darum noch nicht. -->
    <PackageVersion Include="NAudio.WinMM" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup Label="Chat-Anzeige">
    <!-- 1.4.2 statt 1.5.1: Die 1.5er-Reihe war beim Einbau erst wenige Tage alt. -->
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
